# ──── Concierge (NLP parse-trip) ─────────────────────────────────────────
# Required when using the Groq adapter (default). Add the key to your local .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Set to "true" to use the rule-based MockAdapter instead of Groq.
USE_MOCK_PARSER=false

# When true, a model failure (quota/timeout) falls back to MockAdapter automatically.
ENABLE_MOCK_FALLBACK=false

# ──── Transport repository ───────────────────────────────────────────────
# "json" (demo data) or "supabase" (read planner data from Supabase REST API).
TRANSPORT_REPOSITORY=supabase
# TRANSPORT_DATA_PATH=app/data/transport_options.json
# Set both values and TRANSPORT_REPOSITORY=supabase to load planner data from Supabase.
SUPABASE_URL=
# Use the anon/public key with read-only RLS policies. Never use the service_role key here.
SUPABASE_KEY=
# PostgreSQL URI used by Alembic migrations at Render container startup.
# Use postgresql+psycopg://...; postgresql:// and postgres:// are normalized too.
DATABASE_URL=

# RailRadar API key for real train timetable/live status. Keep this server-side.
RAILRADAR_API_KEY=

# ──── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins. "*" allows everything (fine for local dev).
CORS_ORIGINS=*

# ──── Model timeout ─────────────────────────────────────────────────────
MODEL_TIMEOUT_SECONDS=60
